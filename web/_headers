/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data:; media-src 'self' blob:; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://api.groq.com https://api.opentyphoon.ai https://api.openai.com https://accounts.google.com/gsi/ https://www.googleapis.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000

/index.html
  Cache-Control: no-store

/sw.js
  Cache-Control: no-cache
